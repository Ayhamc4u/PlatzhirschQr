# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Python cache artifacts
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# environment files
# Never commit real environment files. .env.test and .env.example are intentionally versioned
# and must contain test/dummy/example values only.
.env*
!.env.test
!.env.example
.env copy

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
