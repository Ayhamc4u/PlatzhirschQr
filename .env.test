# Platzhirsch test environment
#
# This file is intentionally committed and MUST contain test/dummy values only.
# Production secrets belong in the server-side .env file that is mounted into
# the Docker container at runtime.

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/platzhirsch_test

# Authentication
NEXTAUTH_URL=http://localhost:3050
NEXTAUTH_SECRET=platzhirsch-test-only-nextauth-secret

# Dine-in / QR access
# Used to sign and verify table/venue access tokens. Never reuse this value in production.
DINEIN_QR_SECRET=platzhirsch-test-only-dinein-secret
DINEIN_ACCESS_MODE=test

# Optional AI providers (legacy/optional module)
# Keep dummy values here so tests can validate configuration without real credentials.
AI_GROQ_KEY=test-only
AI_CEREBRAS_KEY=test-only
AI_GOOGLE_KEY=test-only
AI_SILICONFLOW_KEY=test-only
