{
	"name": "platzhirschqr",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": "22.22.3"
	},
	"scripts": {
		"play": "next dev",
		"sync:menu": "node scripts/sync-ready2order-products.js && node scripts/sync-ready2order-menu.js",
		"sync:tables": "node scripts/sync-ready2order-tables.js",
		"sync:ready2order": "pnpm sync:menu && pnpm sync:tables",
		"dev": "pnpm sync:ready2order && PORT=3050 next dev",
		"build:dev": "doppler run --command=\"next build\"",
		"build": "next build",
		"start": "next start",
		"lint": "biome check --write",
		"clean": "rm -rf node_modules pnpm-lock.yaml .next && pnpm install"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.46",
		"@react-pdf/renderer": "^4.9.0",
		"@yudiel/react-qr-scanner": "^2.6.0",
		"ai": "^7.0.96",
		"bcrypt": "^6.0.0",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"lodash": "^4.18.1",
		"mongoose": "^9.9.5",
		"next": "16.3.4",
		"next-auth": "^4.24.15",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-intersection-observer": "^11.0.1",
		"react-toastify": "^11.1.0",
		"sass": "^1.104.0",
		"swr": "^2.5.1",
		"xtreme-ui": "^0.0.134",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@svgr/webpack": "^8.1.0",
		"@types/bcrypt": "^6.0.0",
		"@types/lodash": "^4.17.25",
		"@types/node": "22.20.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "7.0.2",
		"ultracite": "7.11.1"
	}
}
