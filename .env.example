# PlatzhirschQR local development template
# Copy this file to .env.local and replace all placeholder values.

MONGODB_URI="mongodb://USER:PASSWORD@HOST:27017/qrorder?authSource=admin"
RESTAURANT_ID=platzhirsch
PUBLIC_APP_URL=http://localhost:3050

READY2ORDER_API_BASE=https://api.ready2order.com/v1
READY2ORDER_ACCOUNT_TOKEN=REPLACE_ME
READY2ORDER_TRAINING_MODE=true
# Optional technical 0-EUR product used to print pickup contact details.
READY2ORDER_CONTACT_PRODUCT_ID=

NEXTAUTH_URL=http://localhost:3050
NEXTAUTH_SECRET=REPLACE_ME

# Customer/account email via World4You.
# Port 587 uses STARTTLS, therefore EMAIL_SMTP_SECURE=false.
# Never commit the real mailbox password.
EMAIL_SMTP_HOST=smtp.world4you.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=noreply@platzhirschzwettl.at
EMAIL_SMTP_PASSWORD=REPLACE_ME
AUTH_EMAIL_FROM="Platzhirsch Zwettl <noreply@platzhirschzwettl.at>"

DINEIN_QR_SECRET=REPLACE_ME
DINEIN_ACCESS_MODE=development

# Docker/production runtime: sync products, menu and tables before the web server starts.
SYNC_READY2ORDER_ON_STARTUP=true
